# Every sink type against examples/receivers.py and LocalStack, for a workstation test.
# Append to nuxeo.conf, restart, then create or edit a document. Dummy credentials only.
maretha.audit.forwarder.enabled=true
maretha.audit.forwarder.sinks=splunk,syslog,qradar,sentinel,hook,queue
maretha.audit.forwarder.source.host=workstation
maretha.audit.forwarder.health.check.enabled=true

maretha.audit.forwarder.sink.splunk.type=splunk
maretha.audit.forwarder.sink.splunk.url=http://127.0.0.1:18088/services/collector/event
maretha.audit.forwarder.sink.splunk.token=e2e-token
maretha.audit.forwarder.sink.splunk.index=nuxeo

maretha.audit.forwarder.sink.syslog.type=syslog
maretha.audit.forwarder.sink.syslog.host=127.0.0.1
maretha.audit.forwarder.sink.syslog.port=15514
maretha.audit.forwarder.sink.syslog.protocol=tcp
maretha.audit.forwarder.sink.syslog.format=cef

maretha.audit.forwarder.sink.qradar.type=qradar
maretha.audit.forwarder.sink.qradar.host=127.0.0.1
maretha.audit.forwarder.sink.qradar.port=15515
maretha.audit.forwarder.sink.qradar.protocol=tcp

maretha.audit.forwarder.sink.sentinel.type=sentinel
maretha.audit.forwarder.sink.sentinel.endpoint=http://127.0.0.1:18088
maretha.audit.forwarder.sink.sentinel.authority=http://127.0.0.1:18088
maretha.audit.forwarder.sink.sentinel.tenant.id=tenant-e2e
maretha.audit.forwarder.sink.sentinel.client.id=app-e2e
maretha.audit.forwarder.sink.sentinel.client.secret=e2e-secret
maretha.audit.forwarder.sink.sentinel.dcr.id=dcr-e2e
maretha.audit.forwarder.sink.sentinel.stream=Custom-NuxeoAudit

maretha.audit.forwarder.sink.hook.type=webhook
maretha.audit.forwarder.sink.hook.url=http://127.0.0.1:18088/hook
maretha.audit.forwarder.sink.hook.auth.type=bearer
maretha.audit.forwarder.sink.hook.auth.token=e2e-bearer
maretha.audit.forwarder.sink.hook.hmac.secret=e2e-hmac
maretha.audit.forwarder.sink.hook.events=loginSuccess,documentCreated

maretha.audit.forwarder.sink.queue.type=sqs
maretha.audit.forwarder.sink.queue.queue.url=http://localhost:4566/000000000000/nuxeo-audit
maretha.audit.forwarder.sink.queue.region=us-east-1
maretha.audit.forwarder.sink.queue.endpoint=http://localhost:4566
maretha.audit.forwarder.sink.queue.access.key.id=test
maretha.audit.forwarder.sink.queue.secret.access.key=test
