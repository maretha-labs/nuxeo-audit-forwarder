<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.nuxeo</groupId>
    <artifactId>nuxeo-parent</artifactId>
    <version>2025.26</version>
  </parent>

  <groupId>io.maretha.audit</groupId>
  <artifactId>nuxeo-audit-forwarder-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Nuxeo Audit Forwarder</name>
  <description>Forwards Nuxeo audit events to Splunk, IBM QRadar, Microsoft Sentinel, syslog, an authenticated HTTPS
    webhook and Amazon SQS.</description>

  <properties>
    <nuxeo.skip.enforcer>true</nuxeo.skip.enforcer>
    <nuxeo.target.version>2025.*</nuxeo.target.version>
    <maven.compiler.release>21</maven.compiler.release>
    <!-- not managed by the Nuxeo BOM -->
    <testcontainers.version>2.0.5</testcontainers.version>
  </properties>

  <modules>
    <module>nuxeo-audit-forwarder-core</module>
    <module>nuxeo-audit-forwarder-web</module>
    <module>nuxeo-audit-forwarder-package</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.maretha.audit</groupId>
        <artifactId>nuxeo-audit-forwarder-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.maretha.audit</groupId>
        <artifactId>nuxeo-audit-forwarder-web</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <repositories>
    <repository>
      <id>maven-public</id>
      <url>https://packages.nuxeo.com/repository/maven-public/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>maven-public</id>
      <url>https://packages.nuxeo.com/repository/maven-public/</url>
    </pluginRepository>
  </pluginRepositories>
</project>
